{
  "name": "hr-dashboard",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview --host 127.0.0.1",
    "typecheck": "tsc --noEmit",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "playwright test",
    "test:ui": "playwright test --ui",
    "test:setup": "node scripts/setup-tests.mjs",
    "backend:start": "supabase start --exclude realtime,storage-api,imgproxy,mailpit,studio,edge-runtime,logflare,vector,supavisor",
    "demo:seed": "node --env-file-if-exists=.env.admin.local scripts/demo-accounts.mjs seed",
    "demo:reset-password": "node --env-file-if-exists=.env.admin.local scripts/demo-accounts.mjs reset-password",
    "supabase": "supabase"
  },
  "dependencies": {
    "@supabase/supabase-js": "2.117.3",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "react-router": "8.4.0"
  },
  "devDependencies": {
    "@playwright/test": "1.64.0",
    "@types/node": "26.6.5",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.1.2",
    "prettier": "3.9.10",
    "supabase": "2.120.0",
    "typescript": "7.0.2",
    "vite": "8.3.4"
  }
}
